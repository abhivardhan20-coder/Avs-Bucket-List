# ─────────────────────────────────────────────────────────────
# API Server — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/bucketlist

# Authentication
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Redis (token blacklist cache)
REDIS_URL=redis://localhost:6379

# TMDB API (proxied through backend in production)
TMDB_API_KEY=your_tmdb_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ALLOW_CREDENTIALS=true

# Token Blacklist
BLACKLIST_EXPIRY_MS=86400000

# Preferences Cache
PREFERENCES_CACHE_TTL_SECONDS=86400

# Email (optional — leave blank for mock emails in dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sentry Error Tracking (optional)
SENTRY_DSN=
