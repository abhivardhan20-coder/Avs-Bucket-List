{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && (node --enable-source-maps ./dist/worker.mjs & node --enable-source-maps ./dist/index.mjs)",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/worker.mjs & node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "catalog:",
    "@types/node-cache": "4.2.5",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "2.3.3",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "4.1.8"
  }
}
