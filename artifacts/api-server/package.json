{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && (node --enable-source-maps ./dist/worker.mjs & node --enable-source-maps ./dist/index.mjs)",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/worker.mjs & node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "catalog:",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "openapi-types": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "swagger-jsdoc": "catalog:",
    "swagger-ui-express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/node-cron": "catalog:",
    "@types/supertest": "catalog:",
    "@types/swagger-jsdoc": "catalog:",
    "@types/swagger-ui-express": "catalog:",
    "esbuild": "catalog:",
    "esbuild-plugin-pino": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "thread-stream": "catalog:",
    "vitest": "catalog:"
  }
}
