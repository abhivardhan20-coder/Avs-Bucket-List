# ─────────────────────────────────────────────────────────────
# AVS Bucket List — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Backend (API Server) ──────────────────────────────────────
PORT=3000
# FRONTEND_URL must be explicitly set to your actual domain in production (e.g. https://your-app.com)
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@host:5432/db
SUPABASE_JWT_SECRET=super_secret_string_min_32_chars_long_...
SENTRY_DSN=
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Google Apps Script Sync (optional)
GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GAS_SECRET=your_gas_secret_here

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_GOOGLE_SHEETS_API_URL=http://127.0.0.1:8000/api/sync

# Optional: External metadata providers
VITE_TRAKT_CLIENT_ID=your_trakt_client_id
VITE_TRAKT_CLIENT_SECRET=your_trakt_client_secret
VITE_TVDB_API_KEY=your_tvdb_api_key
VITE_FANART_API_KEY=your_fanart_api_key
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# Cloud Sync Token (optional)
VITE_GOOGLE_SHEETS_TOKEN=your_sheets_token_here
