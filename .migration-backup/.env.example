# .env.example — commit this, never .env
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Optional: Enable demo preview mode (development only, never enable in production)
VITE_ENABLE_DEMO=false

# Optional: Sentry DSN for error monitoring
# VITE_SENTRY_DSN=https://your-sentry-dsn

# ⚠ API keys for TMDB, Fanart, TVDB, and Trakt are stored as
# Supabase Edge Function secrets, NOT as VITE_ env vars.
# Set them via: supabase secrets set TMDB_KEY=your-tmdb-key
# See docs/SUPABASE_SETUP.md for details.
